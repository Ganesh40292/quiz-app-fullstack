# ==========================================
# QUIZORA PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to .env and populate with secure production values
# ==========================================

# 🐬 Database Configuration
DB_URL=jdbc:mysql://localhost:3306/quizdb?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_secure_db_password
DB_ROOT_PASSWORD=your_secure_db_root_password
DB_POOL_MAX=10
DB_POOL_MIN=3

# 🔑 JWT Security Configuration (Must be 32+ characters)
JWT_SECRET=your_32_character_minimum_random_secret_string_here

# 🌐 Port & Server Configuration
PORT=8080
REACT_APP_API_URL=/api

# 🔍 Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
